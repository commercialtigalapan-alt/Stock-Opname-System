function toClient_(value, seen){
  if(value === null) return null;
  if(value === undefined) return '';
  if(value instanceof Date) return isNaN(value.getTime()) ? '' : value.toISOString();
  var t=typeof value;
  if(t==='number') return isFinite(value)?value:0;
  if(t==='string'||t==='boolean') return value;
  if(t==='function') return '';
  if(Array.isArray(value)) return value.map(function(v){return toClient_(v,seen);});
  if(t==='object'){
    seen=seen||[];
    if(seen.indexOf(value)>=0) return '[Circular]';
    seen.push(value);
    var out={};
    Object.keys(value).forEach(function(k){out[k]=toClient_(value[k],seen);});
    seen.pop();
