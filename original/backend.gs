// ============================================================================
// V39 HOTFIX - NEW USER LOGIN / SESSION RACE FIX
// Fixes:
// 1) Stale RPC responses from the previous account can no longer clear a newer
//    session on the browser (frontend companion patch).
// 2) Expired V13 session properties are pruned before a new session is stored.
// 3) Session persistence is verified instead of failing silently.
// 4) Login bootstrap reports V39 capabilities.

var APP_V39_VERSION = '39.0.0';

function v39PruneExpiredSessions_(){
  var props=PropertiesService.getScriptProperties(),all={},now=Date.now(),removed=0,valid=[];
  try{all=props.getProperties()||{};}catch(e){return {removed:0,kept:0,error:String(e&&e.message||e)};}
  Object.keys(all).forEach(function(k){
    if(String(k).indexOf('V13_SESSION_')!==0)return;
    var raw=all[k],d=null;
    try{d=JSON.parse(raw||'');}catch(ignore){}
    if(!d || !d.expiresAt || Number(d.expiresAt)<=now){
      try{props.deleteProperty(k);removed++;}catch(ignore2){}
      try{CacheService.getScriptCache().remove(k);}catch(ignore3){}
    }else{
      valid.push({key:k,expiresAt:Number(d.expiresAt)||0});
    }
  });
  // Defensive cap: keep the 120 sessions with the furthest expiry.
  // This prevents abandoned browser sessions from exhausting Script Properties.
  if(valid.length>120){
    valid.sort(function(a,b){return b.expiresAt-a.expiresAt;});
    valid.slice(120).forEach(function(x){
      try{props.deleteProperty(x.key);removed++;}catch(ignore4){}
      try{CacheService.getScriptCache().remove(x.key);}catch(ignore5){}
    });
    valid=valid.slice(0,120);
  }
  return {removed:removed,kept:valid.length};
}

// Replace the legacy silent-write session store with a verified store.
v13PutSession_ = function(token,user){
  assert_(String(token||''),'Token session kosong.');
  assert_(user&&user.USER_ID,'User session tidak valid.');

  // Clear expired entries first so Script Properties has room for a new user.
  try{v39PruneExpiredSessions_();}catch(ignore0){}

  var hours=Math.max(1,Math.min(6,Number(v6ConfigMap_().LOGIN_SESSION_HOURS||6)));
  var exp=Date.now()+hours*3600000;
  var data={token:String(token),user:user,expiresAt:exp,createdAt:Date.now(),appVersion:APP_V39_VERSION};
  var raw=JSON.stringify(data),key=v13SessionKey_(token),ttl=Math.min(21600,hours*3600);
  var cacheOk=false,propsOk=false,cache=CacheService.getScriptCache(),props=PropertiesService.getScriptProperties();

  try{
    cache.put(key,raw,ttl);
    cacheOk=!!cache.get(key);
  }catch(ignore1){}

  try{
    props.setProperty(key,raw);
    propsOk=!!props.getProperty(key);
  }catch(firstWriteError){
    // Quota can be consumed by old sessions. Prune and retry once.
    try{v39PruneExpiredSessions_();}catch(ignore2){}
    try{
      props.setProperty(key,raw);
      propsOk=!!props.getProperty(key);
    }catch(ignore3){}
  }

  assert_(cacheOk||propsOk,'Session login gagal disimpan. Silakan login kembali atau hubungi Admin SO.');
  return data;
};

