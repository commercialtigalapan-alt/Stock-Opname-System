// ============================================================================
// V36 - LOGIN / SESSION / ROLE CONTEXT FIX
// Fixes:
// 1) Custom login bootstrap always runs under the authenticated USER session.
// 2) Login role is synchronized from ROLE; it can no longer drift to Super Admin.
// 3) Duplicate usernames are rejected.
// 4) Password reset uses hash only (no plaintext password persistence).
// 5) User save auto-creates a unique username for new users.

var APP_V36_VERSION = '36.0.0';

function v36NormalizeUsername_(value){
  return String(value || '').trim().toLowerCase();
}

function v36WithAuthContext_(user, callback){
  var previous = (typeof V13_AUTH_CONTEXT !== 'undefined') ? V13_AUTH_CONTEXT : null;
  V13_AUTH_CONTEXT = user;
  try{
    return callback();
  }finally{
    V13_AUTH_CONTEXT = previous || null;
  }
}

function v36RowsByUsername_(username){
  var target = v36NormalizeUsername_(username);
  if(!target) return [];
  return readTable_(APP.SHEETS.USERS).filter(function(row){
    return v36NormalizeUsername_(row.USERNAME) === target;
  });
}

function v36UniqueUsername_(row, excludeUserId){
  row = row || {};
  var email = normalizeEmail_(row.EMAIL || '');
  var base = email ? email.split('@')[0] : String(row.NAME || 'user').toLowerCase();
  base = base.replace(/[^a-z0-9._-]+/g,'.').replace(/^\.+|\.+$/g,'') || 'user';

  var used = {};
  readTable_(APP.SHEETS.USERS).forEach(function(u){
    if(excludeUserId && String(u.USER_ID) === String(excludeUserId)) return;
    var uname = v36NormalizeUsername_(u.USERNAME);
    if(uname) used[uname] = true;
  });

  var candidate = base, n = 1;
  while(used[candidate]){
    n++;
    candidate = base + '.' + n;
  }
  return candidate;
}

function v36AssertUniqueUsername_(username, excludeUserId){
  var target = v36NormalizeUsername_(username);
  assert_(target,'Username wajib diisi.');
  var duplicate = readTable_(APP.SHEETS.USERS).filter(function(u){
    if(excludeUserId && String(u.USER_ID) === String(excludeUserId)) return false;
    return v36NormalizeUsername_(u.USERNAME) === target;
  });
  assert_(!duplicate.length,'Username "'+target+'" sudah digunakan akun lain. Gunakan username yang berbeda.');
  return target;
}

function v36BuildBootstrap_(user){
  return v36WithAuthContext_(user,function(){
    var data = v15BootstrapData_(user);
    data.version = APP_V36_VERSION;
    data.loginMode = 'USERNAME_PASSWORD_SESSION_V36';
    data.authContext = 'CUSTOM_LOGIN_TOKEN';
    return data;
  });
}

// IMPORTANT: V15/V16 previously called v15BootstrapData_(user) without setting
// V13_AUTH_CONTEXT. Under V35 store filtering this could fall back to Google
// Session identity (often the deployer / Super Admin). V36 closes that path.

// Secure admin reset: unique username + hash only + LOGIN_ROLE derived from ROLE.

// Keep profile ROLE and LOGIN_ROLE synchronized whenever User Management saves a row.
// New users receive a unique username automatically; password is still created via Reset Login.
var v36SaveUserBase_ = saveUserV2;
saveUserV2 = function(row){
  try{
    requireRole_(['SUPER_ADMIN','ADMIN_SO']);
    row = row || {};

    var existing = null;
    if(row.USER_ID) existing = findOne_(APP.SHEETS.USERS,'USER_ID',row.USER_ID);
    if(!existing && row.EMAIL){
      var email = normalizeEmail_(row.EMAIL);
      existing = readTable_(APP.SHEETS.USERS).filter(function(u){
        return normalizeEmail_(u.EMAIL) === email;
      })[0] || null;
    }

    var role = String(row.ROLE || (existing && existing.ROLE) || '').toUpperCase();
    if(role){
      row.LOGIN_ROLE = v13LoginRole_(role);
    }

    var statusValue = String(row.STATUS || (existing && existing.STATUS) || 'ACTIVE').toUpperCase();
    row.LOGIN_STATUS = statusValue === 'ACTIVE' ? 'ACTIVE' : 'INACTIVE';

    var currentUsername = v36NormalizeUsername_(row.USERNAME || (existing && existing.USERNAME) || '');
    if(!currentUsername){
      currentUsername = v36UniqueUsername_(
        {EMAIL:row.EMAIL || (existing && existing.EMAIL),NAME:row.NAME || (existing && existing.NAME)},
        existing && existing.USER_ID
      );
    }
    row.USERNAME = v36AssertUniqueUsername_(currentUsername,existing && existing.USER_ID);

    var result = v36SaveUserBase_(row);
    if(result && result.ok !== false && result.data){
      result.data.LOGIN_ROLE = row.LOGIN_ROLE;
      result.data.LOGIN_STATUS = row.LOGIN_STATUS;
      result.data.USERNAME = row.USERNAME;
    }
    return result;
  }catch(e){
    return fail_(e);
  }
};

// One-click repair for existing accounts.
// It fixes missing/duplicate usernames and LOGIN_ROLE mismatch.
// Users without a password hash are reported and must use "Reset Login".
function repairLoginUsersV36(){
  try{
    var actor = requireRole_(['SUPER_ADMIN','ADMIN_SO']);
    var users = readTable_(APP.SHEETS.USERS);
    var used = {};
    var fixed = 0, renamed = [], resetRequired = [], roleFixed = [];

    users.forEach(function(user){
      var patch = {};
      var originalUsername = v36NormalizeUsername_(user.USERNAME);
      var username = originalUsername;

      if(!username || used[username]){
        username = v36UniqueUsername_(
          {EMAIL:user.EMAIL,NAME:user.NAME},
          user.USER_ID
        );
        // v36UniqueUsername_ checks the sheet, but during this same repair pass
        // also avoid a username chosen earlier in memory.
        var base = username, n = 1;
        while(used[username]){
          n++;
          username = base + '.' + n;
        }
        patch.USERNAME = username;
        renamed.push({
          userId:user.USER_ID,
          name:user.NAME || user.EMAIL || user.USER_ID,
          from:originalUsername || '(kosong)',
          to:username
        });
      }
      used[username] = true;

      var expectedLoginRole = v13LoginRole_(user.ROLE);
      if(String(user.LOGIN_ROLE || '') !== String(expectedLoginRole)){
        patch.LOGIN_ROLE = expectedLoginRole;
        roleFixed.push({
          userId:user.USER_ID,
          name:user.NAME || user.EMAIL || user.USER_ID,
          role:user.ROLE,
          loginRole:expectedLoginRole
        });
      }

      var expectedStatus = String(user.STATUS || 'ACTIVE').toUpperCase() === 'ACTIVE' ? 'ACTIVE' : 'INACTIVE';
      if(String(user.LOGIN_STATUS || '').toUpperCase() !== expectedStatus){
        patch.LOGIN_STATUS = expectedStatus;
      }

      if(!(user.PASSWORD_HASH && user.PASSWORD_SALT)){
        resetRequired.push({
          userId:user.USER_ID,
          name:user.NAME || user.EMAIL || user.USER_ID,
          username:username,
          role:user.ROLE
        });
      }

      if(Object.keys(patch).length){
        patch.UPDATED_AT = now_();
        patch.UPDATED_BY = actor.EMAIL;
        updateById_(APP.SHEETS.USERS,'USER_ID',user.USER_ID,patch);
        fixed++;
      }
    });

    try{v8InvalidateRefCache_();}catch(ignore){}
    audit_('REPAIR_LOGIN_USERS_V36','USERS','BULK',null,{
      fixed:fixed,
      renamed:renamed.length,
      roleFixed:roleFixed.length,
      resetRequired:resetRequired.length
    });

    return result_({
      version:APP_V36_VERSION,
      fixed:fixed,
      renamed:renamed,
      roleFixed:roleFixed,
      resetRequired:resetRequired
    });
  }catch(e){
    return fail_(e);
  }
}

