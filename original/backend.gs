function firstTimeSetup(){
  try {
    var spreadsheetId = APP.DEFAULT_SPREADSHEET_ID;
    PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID', spreadsheetId);
    var ss = soaOpenById_(spreadsheetId);
    var required = Object.keys(APP.SHEETS).map(function(k){ return APP.SHEETS[k]; });
    var missing = required.filter(function(name){ return !ss.getSheetByName(name); });
    assert_(!missing.length, 'Database belum lengkap. Sheet yang tidak ditemukan: ' + missing.join(', '));

    var email = normalizeEmail_(Session.getActiveUser().getEmail());
    assert_(email, 'Email akun Google tidak terbaca. Pastikan Anda menjalankan setup dari akun Google Workspace yang akan menjadi Super Admin.');
    var user = readTable_(APP.SHEETS.USERS).filter(function(u){ return normalizeEmail_(u.EMAIL) === email; })[0];
    if (!user) {
      appendObject_(APP.SHEETS.USERS, {
        USER_ID: uuid_(), EMAIL: email, NAME: email.split('@')[0], EMPLOYEE_ID: '', ROLE: 'SUPER_ADMIN',
        AREA_ID: '', STORE_ID: '', STATUS: 'ACTIVE', CREATED_AT: now_(), CREATED_BY: email, UPDATED_AT: now_(), UPDATED_BY: email
      });
    } else {
      updateById_(APP.SHEETS.USERS, 'USER_ID', user.USER_ID, {ROLE:'SUPER_ADMIN', STATUS:'ACTIVE', UPDATED_AT:now_(), UPDATED_BY:email});
    }

    var root = getRootFolder_();
    var cfg = findOne_(APP.SHEETS.CONFIG, 'KEY', 'DRIVE_ROOT_FOLDER_ID');
    if (cfg) updateById_(APP.SHEETS.CONFIG, 'KEY', 'DRIVE_ROOT_FOLDER_ID', {VALUE:root.getId(), UPDATED_AT:now_(), UPDATED_BY:email});

    ScriptApp.getProjectTriggers().filter(function(t){return t.getHandlerFunction()==='runReminderEngine';}).forEach(function(t){ScriptApp.deleteTrigger(t);});
    ScriptApp.newTrigger('runReminderEngine').timeBased().everyHours(1).create();

    soaFlush_();
    return result_({
      installed:true,
      spreadsheetId:spreadsheetId,
      spreadsheetName:ss.getName(),
      superAdmin:email,
      rootFolderId:root.getId(),
      reminderTrigger:'HOURLY',
      nextStep:'Deploy as Web app'
    });
  } catch(e) {
    return fail_(e);
  }
}

