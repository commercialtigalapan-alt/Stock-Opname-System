// ==================== V5 Performance, Mapping & Signature Upgrade ====================
function v5ChunkSize_(){ return Math.max(250,Math.min(1000,Number(getConfig_('UPLOAD_CHUNK_SIZE')||750))); }
function v5Norm_(v){ return String(v||'').trim().toUpperCase().replace(/\s+/g,' '); }
function inferBrandV5_(name,category){
  var n=v5Norm_(name),c=v5Norm_(category);
  if(n.indexOf('MYNO')>=0||c.indexOf('MYNO')>=0) return 'MYNO';
  if(n.indexOf('MAMU')>=0||c.indexOf('MAMU')>=0) return 'MAMU';
  return 'TIGALAPAN';
}
function inferColorV5_(name,category,brand){
  var n=v5Norm_(name),b=v5Norm_(brand||inferBrandV5_(name,category));
  var marker=/\b(?:24S|30S|20S|16S|KID|KIDS|WK|WANGKI|WANGKY|PDK|PJG|MAMU|MYNO|POLO|RIB)\b/;
  var m=marker.exec(n),color=m?n.slice(0,m.index).trim():'';
  color=color.replace(/\b(?:TIGALAPAN|KAOS|PLAIN|COTTON)\b/g,' ').replace(/\s+/g,' ').trim();
  if(b==='MAMU'&&color==='A LOCAL BRAND') return '';
  return color;
}
function activeCostMapV5_(){
  var rows=readTable_(APP.SHEETS.COST_LIBRARY),m={};
  rows.forEach(function(r){if(String(r.STATUS||'ACTIVE').toUpperCase()==='ACTIVE'&&r.PRODUCT_NAME)m[normalizeItemName_(r.PRODUCT_NAME)]=r;});
  return m;
}
