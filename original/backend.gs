  if(/\b(?:D20|20S)\b/.test(x))return 'COMBED 20S';
  if(/\b(?:V16|16S)\b/.test(x))return 'COMBED 16S';
  if(/\b(?:WK|WANGKI|WANGKY)\b/.test(x))return 'WANGKI';
  if(/\b(?:BABY\s*TERRY|BT)\b/.test(x))return 'BABY TERRY';
