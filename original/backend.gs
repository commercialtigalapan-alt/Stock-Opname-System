      currentRows.push({STORE_INVENTORY_ID:uuid_(),STORE_ID:payload.storeId,SKU_ID:sku.SKU_ID,SKU_CODE:sku.SKU_CODE,PRODUCT_NAME:sku.PRODUCT_NAME,CATEGORY:category,SYSTEM_QTY:qty,COST:cost,SYSTEM_VALUE:qty*cost,SNAPSHOT_ID:payload.snapshotId,SNAPSHOT_DATE:date,SOURCE_FILE:payload.sourceFile||'Inventory Summary',UPLOAD_BATCH_ID:payload.uploadId,STATUS:'STAGING',UPDATED_AT:now_(),UPDATED_BY:u.EMAIL,NOTES:cost?'':'Cost belum tersedia',BRAND:brand,COLOR:color});
