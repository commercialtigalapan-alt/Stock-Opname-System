      var category=String(r.category||'').trim(),sku=skuMap[key],costRec=costs[key],brand=sku&&sku.BRAND?String(sku.BRAND):inferBrandV5_(name,category),color=sku&&sku.COLOR?String(sku.COLOR):inferColorV5_(name,category,brand);
      if(!sku){sku={SKU_ID:uuid_(),SKU_CODE:autoSkuCode_(name),PRODUCT_NAME:name,CATEGORY:category,COLOR:color,BRAND:brand,COST:costRec?asNumber_(costRec.COST_AMOUNT):0,STATUS:'ACTIVE',UOM:'PCS',CREATED_AT:now_(),UPDATED_AT:now_(),CREATED_BY:u.EMAIL,UPDATED_BY:u.EMAIL,NOTES:'Auto-created V5 from Inventory Summary'};newSku.push(sku);skuMap[key]=sku;}
      var cost=costRec?asNumber_(costRec.COST_AMOUNT):asNumber_(sku.COST);if(costRec)matched++;else missing++;
