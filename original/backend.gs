  ('DEFECT REJECT DTF BUNDLING MAMU MYNO TIGALAPAN PDK PJG KID KIDS WK WANGKI WANGKY COMBED COTTON KAOS RIB BT BABY TERRY FLEECE 24S 30S 20S 16S D20 V16 CC OS NT FORMAL LONG SHORT TUNIK HOODIE CREWNECK CARGO BOMBER HALF ZIP POLO BOXY TEE CHINOS COACH BOWLING SHIRT LOOSE SLEEVE TSHIRT DRESS PLEATED RGL RAGLAN DANBOWL POCKET HANDLE OVAL').split(' ').forEach(function(w){if(w)words[w]=true;});
